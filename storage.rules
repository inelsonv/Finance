rules_version = '2';

// Solo la cuenta de Google iventuramena@gmail.com puede leer o escribir
// archivos en este Storage.

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.token.email == "iventuramena@gmail.com";
    }
  }
}
