rules_version = '2';

// ATENCIÓN: reglas abiertas solo para desarrollo/pruebas, igual que
// firestore.rules. Antes de compartir la app o usar datos reales, agrega
// autenticación y cambia esto por algo como:
//
// match /productos/{id} {
//   allow read: if true;
//   allow write: if request.auth != null;
// }

service firebase.storage {
  match /b/{bucket}/o {
    match /productos/{id} {
      allow read, write: if true;
    }
  }
}
