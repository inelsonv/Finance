rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function esPropietario() {
      return request.auth != null && request.auth.token.email == "iventuramena@gmail.com";
    }

    // Registro general de perfiles de usuario (Lectura/escritura propia, lectura administrativa para propietario)
    match /usuariosRegistrados/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || esPropietario());
    }

    // Espacio de datos 100% aislado para cada usuario individual
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || esPropietario());
    }

    // Colecciones raíz: datos existentes preservados exclusivamente para la cuenta propietaria original
    match /{collectionName}/{docId} {
      allow read, write: if esPropietario();
    }
  }
}

