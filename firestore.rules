rules_version = '2';

// ATENCIÓN: reglas abiertas solo para desarrollo/pruebas.
// Cualquiera con tu configuración de Firebase puede leer y escribir estos datos.
// Antes de usar la app con datos reales o compartir el proyecto, agrega
// autenticación y reemplaza estas reglas por algo como:
//
// match /productos/{doc} {
//   allow read, write: if request.auth != null;
// }

service cloud.firestore {
  match /databases/{database}/documents {
    match /productos/{doc} {
      allow read, write: if true;
    }
    match /listaCompra/{doc} {
      allow read, write: if true;
    }
    match /entidades/{doc} {
      allow read, write: if true;
    }
    match /movimientos/{doc} {
      allow read, write: if true;
    }
    match /prestamos/{doc} {
      allow read, write: if true;
    }
    match /cuentas/{doc} {
      allow read, write: if true;
    }
    match /tarjetas/{doc} {
      allow read, write: if true;
    }
    match /membresias/{doc} {
      allow read, write: if true;
    }
    match /fuentesIngreso/{doc} {
      allow read, write: if true;
    }
    match /categoriasGasto/{doc} {
      allow read, write: if true;
    }
    match /presupuestos/{doc} {
      allow read, write: if true;
    }
    match /contratos/{doc} {
      allow read, write: if true;
    }
    match /flujo/{doc} {
      allow read, write: if true;
    }
    match /acciones/{doc} {
      allow read, write: if true;
    }
    match /config/{doc} {
      allow read, write: if true;
    }
  }
}
